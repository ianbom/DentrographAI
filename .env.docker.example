APP_NAME="Dentograph AI"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_SCRIPT
APP_DEBUG=false
APP_URL=https://dentograph.iandev.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=dentograph
DB_USERNAME=dentograph_user
DB_PASSWORD=change_me
MYSQL_DATABASE=dentograph
MYSQL_USER=dentograph_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.dentograph.iandev.my.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.googlemail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="dentograph@gmail.com"
MAIL_FROM_NAME="Dentograph AI"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_SERVICE_URL=http://fastapi:8001
AI_SERVICE_TIMEOUT=300
AI_SERVICE_CONNECT_TIMEOUT=10
AI_EMBEDDING_SERVICE_URL=http://fastapi:8001
AI_EMBEDDING_SERVICE_TIMEOUT=60
AI_EMBEDDING_SERVICE_CONNECT_TIMEOUT=8
AI_LLM_SERVICE_URL=http://fastapi:8001
AI_LLM_SERVICE_TIMEOUT=60
AI_LLM_SERVICE_CONNECT_TIMEOUT=8
AI_LLM_CONTEXT_MAX_CHARS=12000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

VITE_APP_NAME="${APP_NAME}"
